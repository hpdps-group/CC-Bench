{
  /*
    Compression Kernel Selection

    mode 0 — bare
      Baseline without compression, test raw performance.
      No fields required.

    mode 1 — direct-lib
      User provides precompiled .so.
      Requires: library_paths

    mode 2 — lib+wrapper
      User provides precompiled .so + wrapper source code compiled together.
      Requires: library_paths, source_{files,dirs}, include_{files,dirs}

    mode 3 — pure code wrapper
      User provides source code + wrapper source, all compiled into .so.
      Requires: source_{files,dirs}, include_{files,dirs}

    === Examples ===
    See wrapper_code_examples/compression/sz3/ for an SZ3 (mode 1) example.
    Custom implementations should be placed in your_wrapper_code/compression/.
  */
  "mode": 0,

  "library_paths": ["plugin_projects/compression/SZ3/install/lib64/libSZ3c.so"],

  "source_files": ["run_codes/wrappers/mpi_compress_tools.c"],

  "source_dirs": ["userconfig/wrapper_code_examples/compression/sz3_for_zccl"],

  "include_files": [],

  "include_dirs": [],

  "libraries": [],

  "output_name": "libzccl_sz3.so"
}