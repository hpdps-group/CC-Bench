{
  /*
    Performance Kernel Selection

    Uses LD_PRELOAD wrappers to intercept MPI/compression functions and record performance data.

    mode 0 — bare
      No profiling, no perf wrapper loaded.

    mode 1 — direct-lib
      User provides precompiled profiling .so.
      Requires: library_paths

    mode 2 — lib+wrapper
      User provides precompiled .so + wrapper source code compiled together.
      Requires: library_paths, source_{files,dirs}, include_{files,dirs}

    mode 3 — pure code wrapper
      User provides source code, compiled into profiling .so.
      Requires: source_{files,dirs}, include_{files,dirs}

    === Examples ===
    wrapper_code_examples/perf/perfmpi/perfmpi.c — intercepts MPI_Send / mpi_compress /
    mpi_decompress and records timing. The framework's perf_helper module is required at compile time:
      source_files: ["run_codes/wrappers/src/perf_helper.c",
                     "wrapper_code_examples/perf/perfmpi/perfmpi.c"]
      include_files: ["run_codes/wrappers/include/perf_helper.h"]

    Custom implementations should be placed in your_wrapper_code/perf/.
  */
  "mode": 3,

  "library_paths": [],

  "source_files": ["run_codes/wrappers/src/perf_helper.c",
                   "run_codes/wrappers/src/mpi/perf_helper_mpi.c"],

  "source_dirs": ["userconfig/wrapper_code_examples/perf/perfmpi"],

  "include_files": ["run_codes/wrappers/include/perf_helper.h",
                    "run_codes/wrappers/include/mpi/perf_helper_mpi.h"],

  "include_dirs": ["userconfig/wrapper_code_examples/perf/perfmpi"],

  "libraries": [],

  "output_name": "libperfmpi.so"
}