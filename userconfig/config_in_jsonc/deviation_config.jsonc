{
  /*
    Deviation Metrics Configuration
    Used during the benchmark validation phase: compares compressed-decompressed data with the original.

    Available metrics (use filenames from deviation_metric_examples/, comma-separated):
      mse, mae, psnr, ssim

    Custom metrics should be placed in userconfig/your_deviation_metrics/;
    register_metrics.sh will scan and register them automatically.
  */
  "validation": {
    "enabled": true,
    "selected_metrics": "mse, mae, cos_sim"
  }
}