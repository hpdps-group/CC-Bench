{
  /*
    作业调度配置
    job_choice: "slurm" — 生成 .slurm 脚本，通过 sbatch 提交作业
                "srun"  — 生成 .srun.sh 脚本，在 salloc 后的终端里直接 bash 执行
                "local" — 生成 .sh 脚本，本地单节点直接 mpirun 执行（无需调度器）

    slurm.job:       SLURM SBATCH 参数（仅 job_choice="slurm" 时生效）
    slurm.resources: 硬件资源申请（仅 job_choice="slurm" 时生效）
  */
  "job_choice": "srun",

  "slurm": {
    "job": {
      "name": "communication-bench",
      "output": "%x-%j.out",
      "error": "%x-%j.err",
      "time": "01:00:00",
      "partition": "sdicnormal",
      "qos": "normal"
    },
    "resources": {
      "nodes": 1,
      "tasks_per_node": 4
    }
  }
}
