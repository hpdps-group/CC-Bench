{
  /*
    Job Scheduling Configuration
    job_choice: "slurm" — generates .slurm script, submit via sbatch
                "srun"  — generates .srun.sh script, run with bash inside an salloc session
                "local" — generates .sh script, run locally with mpirun (no scheduler)

    slurm.job:       SLURM SBATCH parameters (only applies when job_choice="slurm")
    slurm.resources: Hardware resource requests (only applies when job_choice="slurm")
  */
  "job_choice": "srun",

  "slurm": {
    "job": {
      "name": "communication-bench",
      "output": "%x-%j.out",
      "error": "%x-%j.err",
      "time": "01:00:00",
      "partition": "sdicnormal",
      "qos": "normal"
    },
    "resources": {
      "nodes": 2,
      "tasks_per_node": 8
    }
  }
}
