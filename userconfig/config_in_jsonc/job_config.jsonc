{
  /*
    Job Scheduling Configuration
    job_choice: "slurm"  — generates .slurm script, submit via sbatch
                "srun"   — generates .srun.sh script, run with bash inside an salloc session
                "mpirun" — generates .mpirun.sh script, uses mpirun as launcher
                           optional: see cross_alloc_nodes for cross-allocation mode
                "local"  — generates .sh script, direct single-node execution (no launcher)

    cross_alloc_nodes (optional):
      When job_choice="mpirun" and this list is non-empty, the generated script
      automatically builds a hostfile from the given node list, cleans SLURM
      environment variables that would confuse mpirun, and launches with
      --hostfile.  This enables running across independent interactive allocations.
      Examples:
        "cross_alloc_nodes": ["d1n41a12g02", "d1n41a26g02", "d1n41a18g01", "d1n41a14g01"]

    slurm.job:       SLURM SBATCH parameters (only applies when job_choice="slurm")
    slurm.resources: Hardware resource requests
  */
  "job_choice": "mpirun",

  "cross_alloc_nodes": ["d1n41a12g02","d1n41a26g02"],

  "slurm": {
    "job": {
      "name": "communication-bench",
      "output": "%x-%j.out",
      "error": "%x-%j.err",
      "time": "01:00:00",
      "partition": "sdicnormal",
      "qos": "normal"
    },
    "resources": {
      "nodes": 2,
      "tasks_per_node": 8
    }
  }
}
