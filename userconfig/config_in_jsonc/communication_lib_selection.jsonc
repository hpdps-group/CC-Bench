{
  /*
    Communication Library Selection

    mode 0 — bare
      Baseline without any wrapper, test raw communication performance.
      No fields required.

    mode 1 — direct-lib
      User provides precompiled .so library.
      Requires: library_paths

    mode 2 — lib+wrapper
      User provides precompiled .so + wrapper source code compiled together.
      Requires: library_paths, source_{files,dirs}, include_{files,dirs}

    mode 3 — pure code wrapper
      User provides source code + wrapper source, all compiled into .so.
      Requires: source_{files,dirs}, include_{files,dirs}

    === Examples ===
    See wrapper_code_examples/communication/zccl/ for a ZCCL example.
    Custom implementations should be placed in your_wrapper_code/communication/.
  */
  "mode": 2,

  "library_paths": ["plugin_projects/ccl/uccl/p2p/libuccl_p2p.so"],
  "source_files": [],

  "source_dirs": ["userconfig/wrapper_code_examples/communication/nccl_via_uccl"],

  "include_files": [],

  "include_dirs": [
    "plugin_projects/ccl/uccl/p2p",
    "plugin_projects/ccl/uccl/p2p/include",
    "plugin_projects/ccl/uccl/include",
    "plugin_projects/ccl/uccl/thirdparty/dietgpu",
    "/tmp/efa_stub/include"
  ],

  "libraries": [],

  "output_name": "libnccl_via_uccl.so"
}
