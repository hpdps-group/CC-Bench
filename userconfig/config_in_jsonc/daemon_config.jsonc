{
  /*
    性能监控 Daemon 配置
    在 benchmark 运行时后台采集系统性能数据（CPU/GPU/网络等）。

    可用 daemon（来自 userconfig/daemon_code_examples/）:
      cpu       — 逐核 CPU 利用率 + 内存利用率
      gpu_nvidia — NVIDIA GPU 利用率、显存、温度、PCIe 状态（依赖 nvidia-smi）
      ib        — InfiniBand 网络带宽统计
      pcie      — PCIe 链路状态监控

    用户自定义 daemon 请放入 userconfig/your_daemons/，
    脚本会自动扫描编译。
  */
  "performance": {
    "enabled": true,
    "selected_daemons": "cpu, ib, pcie,gpu_nvidia",
    "poll_interval_sec": 1.0
  },
  "stress": {
    /*
      CPU Stress Daemon 配置。

      激活方式: 将 "stress_cpu" 加入上方 selected_daemons,
      例如: "cpu, ib, pcie, stress_cpu"

      cpu_percent: CPU 占用率目标 (1-100), 默认 50。

      GPU Stress Daemon (NVIDIA) 配置。

      激活方式: 将 "stress_gpu_nvidia" 加入 selected_daemons,
      例如: "cpu, ib, pcie, stress_cpu, stress_gpu_nvidia"

      gpu_percent: GPU 占用率目标 (1-100), 默认 50。
      依赖 NVIDIA 驱动和 CUDA 库 (daemon_stress_gpu_nvidia.c 编译时需要 -lcuda,
      register_daemons.sh 会自动检测并添加)。
    */
    "cpu_percent": 30,
    "gpu_percent": 30
  }
}
