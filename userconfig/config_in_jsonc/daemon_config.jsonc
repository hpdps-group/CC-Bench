{
  /*
    Performance Monitoring Daemon Configuration
    Collects system performance data (CPU/GPU/network, etc.) in the background during benchmarks.

    Available daemons (from userconfig/daemon_code_examples/):
      cpu       — per-core CPU utilization + memory usage
      gpu_nvidia — NVIDIA GPU utilization, VRAM, temperature, PCIe status (requires nvidia-smi)
      ib        — InfiniBand network bandwidth statistics
      pcie      — PCIe link status monitoring

    Custom daemons should be placed in userconfig/your_daemons/;
    the build script will scan and compile them automatically.
  */
  "performance": {
    "enabled": true,
    "phase1_daemons": "",
    "phase2_daemons": "",
    "poll_interval_sec": 0.5
  },
  "stress": {
    /*
      CPU Stress Daemon Configuration.

      Activation: add "stress_cpu" to the selected_daemons list,
      e.g.: "cpu, ib, pcie, stress_cpu"

      cpu_percent: target CPU utilization (1-100), default 50.

      GPU Stress Daemon (NVIDIA) Configuration.

      Activation: add "stress_gpu_nvidia" to the selected_daemons list,
      e.g.: "cpu, ib, pcie, stress_cpu, stress_gpu_nvidia"

      gpu_percent: target GPU utilization (1-100), default 50.
      Requires NVIDIA driver and CUDA libraries (daemon_stress_gpu_nvidia.c needs -lcuda at compile time;
      register_daemons.sh will auto-detect and add it).
    */
    "cpu_percent": 30,
    "gpu_percent": 30
  }
}
